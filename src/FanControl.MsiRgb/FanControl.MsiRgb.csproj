<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <Product>FanControl MSI RGB</Product>
    <Description>Optional FanControl bridge for the MSI RGB tray app (forwards a curve's %, no hardware access).</Description>
    <!-- Folder holding FanControl.Plugins.dll (FanControl install dir, or ../../lib for CI) -->
    <FanControlDir Condition="'$(FanControlDir)' == ''">$(MSBuildThisFileDirectory)..\..\lib</FanControlDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: never ship a second copy, FanControl must use its own (type identity) -->
    <Reference Include="FanControl.Plugins">
      <HintPath>$(FanControlDir)\FanControl.Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MsiRgb.Core\LinkFile.cs" Link="Core\LinkFile.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FanControl.MsiRgb.Tests" />
  </ItemGroup>

</Project>
