<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for the notification-area icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MsiRgb</AssemblyName>
    <RootNamespace>MsiRgb</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.3.0</Version>
    <Product>MSI RGB</Product>
    <Description>Small replacement for MSI Mystic Light on Renesas-MCU boards: colour, effects, temperature.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- controls are built in code, never by the designer -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MsiRgb.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\MsiRgb.Core\Resources\SmbusI801.bin" LogicalName="SmbusI801.bin" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MsiRgb.Tests" />
  </ItemGroup>

</Project>
