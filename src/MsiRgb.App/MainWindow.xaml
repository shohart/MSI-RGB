<ui:FluentWindow x:Class="MsiRgb.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:c="clr-namespace:MsiRgb.Controls"
                 Title="MSI RGB"
                 Width="1000" Height="830" MinWidth="900" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <!-- Mode tile: big selectable card -->
        <Style x:Key="ModeTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Padding="16,14" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill toggle for effect kinds / which colour is being edited -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="16" Padding="14,7" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter x:Name="cp" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="MSI RGB" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Lightbulb24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,4,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ left: preview + global ============ -->
            <StackPanel Grid.Column="0">
                <ui:Card Padding="20">
                    <StackPanel>
                        <Grid Height="190">
                            <Ellipse x:Name="Glow" Width="150" Height="150" Fill="#0040FF" Opacity="0.55">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="60" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Orb" Width="120" Height="120" Fill="#0040FF"
                                     Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                            <ui:SymbolIcon x:Name="OffIcon" Symbol="Power24" FontSize="44" Visibility="Collapsed"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="PreviewTitle" Text="По температуре" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,2"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="PreviewSub" Text="#0040FF" HorizontalAlignment="Center"
                                   Style="{StaticResource Hint}" />
                        <ui:InfoBar x:Name="ErrorBar" Margin="0,12,0,0" IsOpen="False" IsClosable="False" Severity="Warning" Title="" />
                    </StackPanel>
                </ui:Card>

                <ui:CardControl Margin="0,12,0,0" Icon="{ui:SymbolIcon Power24}">
                    <ui:CardControl.Header>
                        <TextBlock Text="Подсветка" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="EnabledSwitch" />
                </ui:CardControl>

                <ui:Card Margin="0,12,0,0" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Text="100 %" Style="{StaticResource Hint}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BrightnessHigh24" Margin="0,0,8,0" />
                                <TextBlock Text="Яркость" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </DockPanel>
                        <c:GradientSlider x:Name="Brightness" Step="0.05" />
                    </StackPanel>
                </ui:Card>

                <ui:CardControl Margin="0,12,0,0" Icon="{ui:SymbolIcon Rocket24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Запускать с Windows" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="в трее, без запроса UAC" FontSize="12" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AutostartSwitch" />
                </ui:CardControl>
            </StackPanel>

            <!-- ============ right: mode + mode settings ============ -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Режим" Style="{StaticResource Section}" />
                    <UniformGrid Columns="3" Margin="-6,0,-6,16">
                        <RadioButton x:Name="ModeStatic" GroupName="mode" Style="{StaticResource ModeTile}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Color24" FontSize="26" HorizontalAlignment="Left" />
                                <TextBlock Text="Цвет" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Один постоянный цвет" FontSize="12" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeEffect" GroupName="mode" Style="{StaticResource ModeTile}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="26" HorizontalAlignment="Left" />
                                <TextBlock Text="Эффект" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Дыхание, радуга, мигание" FontSize="12" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ModeTemp" GroupName="mode" Style="{StaticResource ModeTile}">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Temperature24" FontSize="26" HorizontalAlignment="Left" />
                                <TextBlock Text="Температура" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Цвет показывает нагрев" FontSize="12" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <!-- static -->
                    <ui:Card x:Name="PageStatic" Padding="20" VerticalContentAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Цвет подсветки" Style="{StaticResource Section}" />
                            <c:ColorPicker x:Name="StaticPicker" />
                        </StackPanel>
                    </ui:Card>

                    <!-- effect -->
                    <StackPanel x:Name="PageEffect">
                        <ui:Card Padding="20">
                            <StackPanel>
                                <TextBlock Text="Эффект" Style="{StaticResource Section}" />
                                <WrapPanel>
                                    <RadioButton x:Name="FxBreathing" GroupName="fx" Style="{StaticResource Pill}" Content="Дыхание" />
                                    <RadioButton x:Name="FxRainbow" GroupName="fx" Style="{StaticResource Pill}" Content="Радуга" />
                                    <RadioButton x:Name="FxBlink" GroupName="fx" Style="{StaticResource Pill}" Content="Мигание" />
                                    <RadioButton x:Name="FxTwoColor" GroupName="fx" Style="{StaticResource Pill}" Content="Переливание двух цветов" />
                                </WrapPanel>
                                <DockPanel Margin="0,10,0,8">
                                    <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Text="5" Style="{StaticResource Hint}" />
                                    <TextBlock Text="Скорость" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </DockPanel>
                                <c:GradientSlider x:Name="Speed" Step="0.112" />
                                <DockPanel Margin="2,2,2,0">
                                    <TextBlock DockPanel.Dock="Right" Text="быстро" FontSize="12" Style="{StaticResource Hint}" />
                                    <TextBlock Text="медленно" FontSize="12" Style="{StaticResource Hint}" />
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card x:Name="FxColorCard" Padding="20" Margin="0,12,0,0">
                            <StackPanel>
                                <WrapPanel x:Name="FxWhich" Margin="0,0,0,6">
                                    <RadioButton x:Name="FxEdit1" GroupName="fxwhich" Style="{StaticResource Pill}" IsChecked="True">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="FxDot1" Width="14" Height="14" Margin="0,0,8,0" Fill="Blue" />
                                            <TextBlock Text="Цвет 1" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="FxEdit2" GroupName="fxwhich" Style="{StaticResource Pill}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="FxDot2" Width="14" Height="14" Margin="0,0,8,0" Fill="Red" />
                                            <TextBlock Text="Цвет 2" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBlock x:Name="FxColorTitle" Text="Цвет эффекта" Style="{StaticResource Section}" />
                                <c:ColorPicker x:Name="FxPicker" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- temperature -->
                    <StackPanel x:Name="PageTemp">
                        <ui:Card Padding="20">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock x:Name="TempNow" DockPanel.Dock="Right" Text="— °C" FontSize="26" FontWeight="SemiBold"
                                               Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Датчик" DockPanel.Dock="Left" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="SensorBox" DisplayMemberPath="Name" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Диапазон и цвета" Style="{StaticResource Section}" Margin="0,0,0,2" />
                                <TextBlock Text="Между порогами цвет плавно переходит от «холодного» к «горячему». Нажмите на плитку, чтобы сменить её цвет." Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TempEditFrom" GroupName="tempwhich" Style="{StaticResource ModeTile}" Margin="0" IsChecked="True">
                                        <DockPanel>
                                            <Ellipse x:Name="TempDotFrom" DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,14,0" Fill="Blue" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Холодно — до" FontSize="12" Style="{StaticResource Hint}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <ui:NumberBox x:Name="TempFrom" Width="84" FontSize="16" Minimum="0" Maximum="120" SmallChange="1" LargeChange="5"
                                                                  MaxDecimalPlaces="0" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                                                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TempEditTo" Grid.Column="2" GroupName="tempwhich" Style="{StaticResource ModeTile}" Margin="0">
                                        <DockPanel>
                                            <Ellipse x:Name="TempDotTo" DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,14,0" Fill="Red" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Горячо — от" FontSize="12" Style="{StaticResource Hint}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <ui:NumberBox x:Name="TempTo" Width="84" FontSize="16" Minimum="0" Maximum="120" SmallChange="1" LargeChange="5"
                                                                  MaxDecimalPlaces="0" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                                                    <TextBlock Text="°C" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </RadioButton>
                                </Grid>

                                <!-- scale with current temperature marker -->
                                <Grid Margin="0,18,0,0" Height="44">
                                    <Border x:Name="TempScale" Height="14" CornerRadius="7" VerticalAlignment="Top" Margin="0,6,0,0"
                                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Canvas x:Name="TempMarkerCanvas" ClipToBounds="False">
                                        <Border x:Name="TempMarker" Width="6" Height="26" CornerRadius="3" Background="White"
                                                BorderBrush="#80000000" BorderThickness="1" Canvas.Top="0" />
                                    </Canvas>
                                    <TextBlock x:Name="ScaleFrom" Text="40 °C" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="12" Style="{StaticResource Hint}" />
                                    <TextBlock x:Name="ScaleTo" Text="85 °C" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="12" Style="{StaticResource Hint}" />
                                </Grid>

                                <Border Height="1" Margin="0,4,0,16" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <TextBlock x:Name="TempColorTitle" Text="Цвет «холодно»" Style="{StaticResource Section}" />
                                <c:ColorPicker x:Name="TempPicker" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
